{{!-- Custom footer for The Public Ledger --}}
{{!-- Hybrid approach: Structure from settings, rich content from pages --}}
{{!-- Create Pages in Ghost Admin with slugs: footer-about, footer-tagline --}}

<footer class="gh-foot-custom">
  <div class="gh-foot-custom-inner">
    {{!-- Main footer content --}}
    <div class="gh-foot-custom-main">
      {{!-- Left column: Logo + About --}}
      <div class="gh-foot-custom-about">
        {{#if @site.logo}}
          <a href="{{@site.url}}" class="gh-foot-custom-logo">
            <img src="{{@site.logo}}" alt="{{@site.title}}" />
          </a>
        {{else}}
          <a href="{{@site.url}}" class="gh-foot-custom-logo-text"> {{@site.title}} </a>
        {{/if}}
        {{!-- Fetch "footer-about" page for rich content --}}
        {{#get "pages" filter="slug:footer-about" limit="1"}}
          
          {{#foreach pages}}
            <h4 class="gh-foot-custom-heading">{{title}}</h4>
            <div class="gh-foot-custom-text">{{content}}</div>
          {{/foreach}}

        {{else}}
          {{!-- Fallback: Create page with slug "footer-about" in Ghost Admin --}}
          <h4 class="gh-foot-custom-heading">ABOUT THIS ARCHIVE</h4>
        {{/get}}
        {{!-- CTAs from settings (simple links) --}}
        <a href="/about" class="gh-foot-custom-cta">
          Meet the people behind it
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path
              d="M7 4l6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        <div class="gh-foot-custom-cta-wrapper">
          <span class="gh-foot-custom-cta-label">For reporters:</span>
          <a href="/tools" class="gh-foot-custom-cta">
            Access premium research tools
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path
                d="M7 4l6 6-6 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>

      {{!-- Right columns: Navigation --}} {{!-- Uses Ghost's secondary navigation (Settings → Navigation) --}}
      <div class="gh-foot-custom-nav">
        <nav class="gh-foot-custom-menu">{{navigation type="secondary"}}</nav>
      </div>
    </div>

    {{!-- Credits section --}}
    <div class="gh-foot-custom-credits">
      <div class="gh-foot-custom-credit">
        <div class="gh-foot-custom-credit-label">THIS ARCHIVE</div>
        <div class="gh-foot-custom-credit-value">{{@site.title}}</div>
      </div>

      <div class="gh-foot-custom-credit">
        <div class="gh-foot-custom-credit-label">REPORTED & PUBLISHED BY</div>
        <div class="gh-foot-custom-credit-value">
          {{!-- <img src="footer_publisher_logo" alt="Publisher logo" class="gh-foot-custom-publisher-logo" /> --}}
          <span>LancasterOnline</span>
        </div>
      </div>

      <div class="gh-foot-custom-credit">
        <div class="gh-foot-custom-credit-label">MADE POSSIBLE BY</div>
        <div class="gh-foot-custom-credit-value">Lancaster County Local Journalism Fund</div>
      </div>
    </div>

    {{!-- Bottom section: Quote + Legal --}}
    <div class="gh-foot-custom-bottom">
      {{!-- Fetch "footer-tagline" page for quote --}}
      {{#get "pages" filter="slug:footer-tagline" limit="1"}}
        
        
        
        
        
        
        {{#foreach pages}}
          <div class="gh-foot-custom-quote">{{content}}</div>
        {{/foreach}}






      {{else}}
        <div class="gh-foot-custom-quote">"An engaged citizenry is the foundation of democracy."</div>
      {{/get}}

      <div class="gh-foot-custom-legal">
        <span>For educational use only</span>
      </div>
    </div>
  </div>
</footer>
