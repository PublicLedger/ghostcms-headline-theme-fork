{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas" id="page-content">
    {{#get "pages" filter="slug:finance-seat-donor" limit="1"}}
      
      {{#foreach pages}}
        {{{content}}}
      {{/foreach}}

    {{else}}
      <h1 id="page-title">Donor Contributions</h1>
      <p>Detailed contribution history.</p>
      <p>
        <em>Configure by creating a Page with slug: <code>finance-seat-donor</code></em>
      </p>
    {{/get}}
  </section>

  <section class="donor-contributions">
    <div class="gh-canvas">
      <div id="finance-donor-app">
        <p>Donor contribution details load here via PublicLedgerData API</p>
      </div>
    </div>
  </section>
</main>

<script>
  (function () {
    const pathParts = window.location.pathname.split("/").filter(p => p);
    const seat = pathParts[1];
    const donor = pathParts[2];
    if (!seat || !donor) return;

    const specificSlug = `finance-seat-donor-${seat}-${donor}`;
    fetch(`/ghost/api/content/pages/slug/${specificSlug}/?key=${window.ghostContentApiKey || ""}`)
      .then(res => (res.ok ? res.json() : null))
      .then(data => {
        if (data && data.pages && data.pages[0]) {
          document.getElementById("page-content").innerHTML = data.pages[0].html;
        } else {
          document.getElementById("page-title").textContent = `Donor Contributions - ${donor} to ${seat}`;
        }
      })
      .catch(() => {
        document.getElementById("page-title").textContent = `Donor Contributions - ${donor} to ${seat}`;
      });

    const app = document.getElementById("finance-donor-app");
    app.dataset.seat = seat;
    app.dataset.donor = donor;
  })();
</script>
