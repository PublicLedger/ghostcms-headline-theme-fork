{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas">
    {{#get "pages" filter="slug:finance-seat-donor-{{seat}}-{{donor}}" limit="1"}}
      {{#foreach pages}}
        {{{content}}}
      {{/foreach}}
    {{else}}
      {{#get "pages" filter="slug:finance-seat-donor" limit="1"}}
      
        {{#foreach pages}}
          {{{content}}}
        {{/foreach}}

    {{else}}
      <h1>Donor Contributions - {{donor}} to {{seat}}</h1>
      <p>Detailed contribution history.</p>
      <p>
        <em
          >Configure by creating a Page with slug: <code>finance-seat-donor</code> or
          <code>finance-seat-donor-{{seat}}-{{donor}}</code></em
        >
      </p>
    {{/get}}
    {{/get}}
  </section>

  <section class="donor-contributions">
    <div class="gh-canvas">
      <div id="finance-donor-app" data-seat="{{seat}}" data-donor="{{donor}}">
        <p>Donor contribution details load here via PublicLedgerData API</p>
      </div>
    </div>
  </section>
</main>
