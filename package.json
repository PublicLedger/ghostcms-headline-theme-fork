{
  "_comment_identity": "Fork-specific identity fields",
  "name": "publicledger-headline-fork",
  "url": "https://publicledger.news",
  "description": "Fork of Ghost Foundation's Headline theme for The Public Ledger project",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "ghost": ">=6.0.0"
  },
  "license": "MIT",
  "_comment_author": "REQUIRED: Must preserve Ghost Foundation as author per MIT license",
  "author": {
    "name": "Ghost Foundation",
    "email": "hello@ghost.org",
    "url": "https://ghost.org"
  },
  "_comment_contributors": "Fork maintainer attribution goes here",
  "contributors": [
    {
      "name": "Gasworks Data",
      "email": "info@gasworksdata.com",
      "url": "https://gasworksdata.com"
    }
  ],
  "_comment_repository": "Fork-specific repository URL",
  "repository": {
    "type": "git",
    "url": "https://github.com/PublicLedger/ghostcms-headline-theme-fork.git"
  },
  "keywords": ["ghost", "ghost-theme", "fork"],
  "docs": "https://headline.ghost.io/about/",
  "_comment_config": "UPSTREAM: Ghost theme configuration - do not modify unless syncing from TryGhost/Headline",
  "config": {
    "posts_per_page": 7,
    "image_sizes": {
      "xs": {
        "width": 150
      },
      "s": {
        "width": 300
      },
      "m": {
        "width": 720
      },
      "l": {
        "width": 960
      },
      "xl": {
        "width": 1200
      },
      "xxl": {
        "width": 2000
      }
    },
    "card_assets": true
  },
  "_comment_scripts": "UPSTREAM scripts: dev, test, zip. FORK additions: validate:fork, ghost:*, lint*",
  "scripts": {
    "dev": "gulp",
    "test": "gscan .",
    "zip": "gulp zip",
    "validate": "gscan . --verbose",
    "validate:fork": "bash scripts/validate-fork.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{hbs,css,js,json,html}\"",
    "format:check": "prettier --check \"**/*.{hbs,css,js,json,html}\"",
    "ghost:seed": "node scripts/ghost-seed.js",
    "ghost:verify": "bash scripts/verify-routes.sh",
    "ghost:records": "bash scripts/ghost-exec.sh sh /var/lib/ghost/content/themes/publicledger-headline-fork/scripts/seed-demo-records.sh",
    "ghost:refresh": "bash scripts/ghost-exec.sh sh /var/lib/ghost/content/themes/publicledger-headline-fork/scripts/refresh-routes.sh",
    "ghost:restart": "echo '⚠️  WARNING: Ghost restart causes terminal hangs. Use \"pnpm ghost:refresh\" to reload routes instead. See /memories/repo/devcontainer-rules.md' && exit 1"
  },
  "_comment_packageManager": "Pinned to match TryGhost/Headline upstream (easier sync)",
  "packageManager": "pnpm@11.9.0",
  "_comment_devDependencies": "UPSTREAM: All dependencies from TryGhost/Headline - do not modify",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gitkumi/prettier-plugin-handlebars": "^1.5.0",
    "@tryghost/admin-api": "^1.14.11",
    "@tryghost/shared-theme-assets": "2.7.1",
    "@tryghost/theme-translations": "^0.0.9",
    "@typescript-eslint/parser": "^8.62.0",
    "autoprefixer": "10.5.0",
    "beeper": "2.1.0",
    "cssnano": "8.0.2",
    "eslint": "^10.6.0",
    "eslint-plugin-jsdoc": "^63.0.10",
    "globals": "^17.7.0",
    "gscan": "6.4.1",
    "gulp": "5.0.1",
    "gulp-concat": "2.6.1",
    "gulp-livereload": "4.0.2",
    "gulp-postcss": "10.0.0",
    "gulp-uglify": "3.0.2",
    "gulp-zip": "5.1.0",
    "ordered-read-streams": "2.0.0",
    "postcss": "8.5.15",
    "postcss-easy-import": "4.0.0",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.4.2",
    "pump": "3.0.4"
  }
}
