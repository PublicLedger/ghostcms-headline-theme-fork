{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas" id="page-content">
    {{#get "pages" filter="slug:election-agency" limit="1"}}
      {{#foreach pages}}
        {{{content}}}
      {{/foreach}}
    {{else}}
      <h1 id="page-title">Agency Elections</h1>
      <p>Election results for this agency.</p>
      <p><em>Configure by creating a Page with slug: <code>election-agency</code></em></p>
    {{/get}}
  </section>

  <section class="agency-elections">
    <div class="gh-canvas">
      <div id="election-agency-app">
        <p>Agency election results load here</p>
      </div>
    </div>
  </section>
</main>

<script>
  (function() {
    const pathParts = window.location.pathname.split("/").filter(p => p);
    const agency = pathParts[1];
    if (!agency) return;
    
    const specificSlug = `election-agency-${agency}`;
    fetch(`/ghost/api/content/pages/slug/${specificSlug}/?key=${window.ghostContentApiKey || ''}`)
      .then(res => res.ok ? res.json() : null)
      .then(data => {
        if (data && data.pages && data.pages[0]) {
          document.getElementById('page-content').innerHTML = data.pages[0].html;
        } else {
          document.getElementById('page-title').textContent = `Elections - ${agency}`;
        }
      })
      .catch(() => { document.getElementById('page-title').textContent = `Elections - ${agency}`; });
    
    document.getElementById('election-agency-app').dataset.agency = agency;
  })();
</script>
