#!/bin/bash
# Pre-commit hook: verify fork integrity and code quality before committing
#
# This script runs automatically before each git commit to catch common issues.
# It replaces the old .pre-commit-config.yaml, which needed Python. Since this
# project uses node:24-alpine (which has no Python), we use this bash script.
#
# Setup: cp scripts/hooks/pre-commit .git/hooks/pre-commit
#
# What was skipped:
#   - check-github-workflows (GitHub checks these on push anyway)
#   - check-yaml for routes (handled by .github/workflows/validate-routes.yaml)
#
# How it works: This script checks your staged changes and reports problems.
# It never auto-fixes files because that would silently commit unstaged work.
# Each error message includes the command you need to run to fix it.

set -e

echo "🔍 Validating fork integrity..."

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Added/Copied/Modified only: deleted paths can't be linted or parsed.
staged=$(git diff --cached --name-only --diff-filter=ACM)

# Filter $staged by an extension regex. Prints nothing when there are no matches.
staged_matching() {
    printf '%s\n' "$staged" | grep -E "$1" || true
}

# Check if LICENSE file is staged
if git diff --cached --name-only | grep -q "^LICENSE$"; then
    echo -e "${RED}❌ ERROR: LICENSE file cannot be modified${NC}"
    echo ""
    echo "The LICENSE file must remain identical to TryGhost/Headline upstream."
    echo "This is required by MIT license compliance."
    echo ""
    echo "To unstage:"
    echo "  git restore --staged LICENSE"
    echo "  git restore LICENSE"
    exit 1
fi

# Built assets are generated by gulp; committing them means the edit is in the
# wrong place and will be overwritten on the next build.
built=$(staged_matching '^assets/built/.*\.(css|js)$')
if [[ -n "$built" ]]; then
    echo -e "${RED}❌ ERROR: built assets cannot be committed${NC}"
    echo ""
    printf '%s\n' "$built" | sed 's/^/  - /'
    echo ""
    echo "Edit the source in assets/css/ or assets/js/ instead."
    exit 1
fi

# Check package.json author field if staged
if git diff --cached --name-only | grep -q "^package.json$"; then
    echo "Checking package.json author field..."

    # Read the STAGED package.json with node, not jq: the devcontainer is
    # node:24-alpine and has no jq. The old `jq ... || echo ""` swallowed the
    # "command not found" and blocked every commit that staged package.json,
    # reporting an empty author as a license violation.
    staged_author=$(git show :package.json |
        node -p "JSON.parse(require('fs').readFileSync(0,'utf8')).author?.name ?? ''" 2>/dev/null) || {
        echo -e "${RED}❌ ERROR: staged package.json is not valid JSON${NC}"
        exit 1
    }

    if [[ "$staged_author" != "Ghost Foundation" ]]; then
        echo -e "${RED}❌ ERROR: package.json author must be 'Ghost Foundation'${NC}"
        echo ""
        echo "Current staged author: $staged_author"
        echo ""
        echo "MIT license requires preserving original attribution."
        echo "Set author to Ghost Foundation and add yourself to contributors array."
        echo ""
        echo "To fix:"
        echo "  # Edit package.json to restore author"
        echo '  "author": {'
        echo '    "name": "Ghost Foundation",'
        echo '    "email": "hello@ghost.org",'
        echo '    "url": "https://ghost.org"'
        echo '  },'
        exit 1
    fi

    echo -e "${GREEN}✅ package.json author correct${NC}"
fi

# JSON syntax. Reads the STAGED blob, not the working tree, so a fixed-but-
# unstaged file can't mask a broken commit.
json_files=$(staged_matching '\.json$')
if [[ -n "$json_files" ]]; then
    while IFS= read -r f; do
        git show ":$f" | node -e \
            'JSON.parse(require("fs").readFileSync(0,"utf8"))' 2>/dev/null || {
            echo -e "${RED}❌ ERROR: invalid JSON in $f${NC}"
            exit 1
        }
    done <<<"$json_files"
    echo -e "${GREEN}✅ JSON syntax valid${NC}"
fi

# Prettier. Same extension set as `pnpm format`, so the suggested fix covers
# exactly what this flags. .prettierignore keeps upstream-owned files out.
fmt_files=$(staged_matching '\.(hbs|css|js|json|html)$')
if [[ -n "$fmt_files" ]]; then
    if ! printf '%s\n' "$fmt_files" | xargs -r pnpm exec prettier --check --; then
        echo -e "${RED}❌ ERROR: formatting issues${NC}"
        echo ""
        echo "To fix:"
        echo "  pnpm format && git add -u"
        exit 1
    fi
    echo -e "${GREEN}✅ Formatting clean${NC}"
fi

# ESLint. Ignores live in eslint.config.js.
js_files=$(staged_matching '\.js$')
if [[ -n "$js_files" ]]; then
    if ! printf '%s\n' "$js_files" | xargs -r pnpm exec eslint --; then
        echo -e "${RED}❌ ERROR: ESLint failures${NC}"
        echo ""
        echo "To fix:"
        echo "  pnpm lint:fix && git add -u"
        exit 1
    fi
    echo -e "${GREEN}✅ ESLint clean${NC}"
fi

# markdownlint runs with no filenames on purpose: passing paths bypasses the
# ignore list in .markdownlint-cli2.jsonc that protects the upstream-owned
# README.md / AGENTS.md / CLAUDE.md.
if [[ -n "$(staged_matching '\.md$')" ]]; then
    if ! pnpm exec markdownlint-cli2; then
        echo -e "${RED}❌ ERROR: markdownlint failures${NC}"
        echo ""
        echo "To fix:"
        echo "  pnpm lint:md:fix && git add -u"
        exit 1
    fi
    echo -e "${GREEN}✅ Markdown clean${NC}"
fi

# Check for changes to theme template files
theme_files_changed=$(staged_matching '\.(hbs|css|js)$' | wc -l)

if [[ $theme_files_changed -gt 0 ]]; then
    # GScan only when the theme itself changed -- it takes seconds, and a
    # docs-only commit has nothing for it to validate.
    echo "Running GScan..."
    if ! pnpm exec gscan .; then
        echo -e "${RED}❌ ERROR: GScan validation failed${NC}"
        echo ""
        echo "See details:"
        echo "  pnpm validate"
        exit 1
    fi
    echo -e "${GREEN}✅ GScan passed${NC}"

    echo -e "${YELLOW}⚠️  Theme files modified (requires careful testing):${NC}"
    staged_matching '\.(hbs|css|js)$' | sed 's/^/  - /'
    echo ""
    echo "Remember to:"
    echo "  1. Test in devcontainer: pnpm dev"
    echo "  2. Validate: pnpm test"
    echo "  3. Build: pnpm zip"
    echo "  4. Document changes for upstream sync conflicts"
fi

echo -e "${GREEN}✅ Fork integrity validated${NC}"
