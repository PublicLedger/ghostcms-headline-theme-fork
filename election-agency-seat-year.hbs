{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas">
    {{#get "pages" filter="slug:election-agency-seat-year-{{agency}}-{{seat}}-{{year}}" limit="1"}}
            {{#foreach pages}}
                {{{content}}}
            {{/foreach}}
        {{else}}
            {{#get "pages" filter="slug:election-agency-seat-year" limit="1"}}
      
      
      
      
                {{#foreach pages}}
                    {{{content}}}
                {{/foreach}}




    {{else}}
      <h1>{{year}} Election - {{seat}} ({{agency}})</h1>
      <p>Results and coverage for this specific election.</p>
      <p>
        <em
          >Configure by creating a Page with slug: <code>election-agency-seat-year</code> or
          <code>election-agency-seat-year-{{agency}}-{{seat}}-{{year}}</code></em
        >
      </p>
    {{/get}}
        {{/get}}
  </section>

  <section class="election-results">
    <div class="gh-canvas">
      <div id="election-year-app" data-agency="{{agency}}" data-seat="{{seat}}" data-year="{{year}}">
        <p>Election results load here (candidates, vote totals, maps, coverage links)</p>
      </div>
    </div>
  </section>
</main>
