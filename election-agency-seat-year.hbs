{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas" id="page-content">
    {{#get "pages" filter="slug:election-agency-seat-year" limit="1"}}
      {{#foreach pages}}
        {{{content}}}
      {{/foreach}}
    {{else}}
      <h1 id="page-title">Election Results</h1>
      <p>Results and coverage for this specific election.</p>
      <p><em>Configure by creating a Page with slug: <code>election-agency-seat-year</code></em></p>
    {{/get}}
  </section>

  <section class="election-results">
    <div class="gh-canvas">
      <div id="election-year-app">
        <p>Election results load here (candidates, vote totals, maps, coverage links)</p>
      </div>
    </div>
  </section>
</main>

<script>
  (function() {
    const pathParts = window.location.pathname.split("/").filter(p => p);
    const agency = pathParts[1];
    const seat = pathParts[2];
    const year = pathParts[3];
    if (!agency || !seat || !year) return;
    
    const specificSlug = `election-agency-seat-year-${agency}-${seat}-${year}`;
    fetch(`/ghost/api/content/pages/slug/${specificSlug}/?key=${window.ghostContentApiKey || ''}`)
      .then(res => res.ok ? res.json() : null)
      .then(data => {
        if (data && data.pages && data.pages[0]) {
          document.getElementById('page-content').innerHTML = data.pages[0].html;
        } else {
          document.getElementById('page-title').textContent = `${year} Election - ${seat} (${agency})`;
        }
      })
      .catch(() => { document.getElementById('page-title').textContent = `${year} Election - ${seat} (${agency})`; });
    
    const app = document.getElementById('election-year-app');
    app.dataset.agency = agency;
    app.dataset.seat = seat;
    app.dataset.year = year;
  })();
</script>
