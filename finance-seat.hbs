{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas" id="page-content">
    {{#get "pages" filter="slug:finance-seat" limit="1"}}
      
      {{#foreach pages}}
        {{{content}}}
      {{/foreach}}

    {{else}}
      <h1 id="page-title">Campaign Finance</h1>
      <p>Contributions and spending for this seat.</p>
      <p>
        <em>Configure by creating a Page with slug: <code>finance-seat</code></em>
      </p>
    {{/get}}
  </section>

  <section class="seat-finance">
    <div class="gh-canvas">
      <div id="finance-seat-app">
        <p>Campaign finance data loads here (top donors, spending, candidate reports)</p>
      </div>
    </div>
  </section>
</main>

<script>
  (function () {
    const pathParts = window.location.pathname.split("/").filter(p => p);
    const seat = pathParts[1];
    if (!seat) return;

    const specificSlug = `finance-seat-${seat}`;
    fetch(`/ghost/api/content/pages/slug/${specificSlug}/?key=${window.ghostContentApiKey || ""}`)
      .then(res => (res.ok ? res.json() : null))
      .then(data => {
        if (data && data.pages && data.pages[0]) {
          document.getElementById("page-content").innerHTML = data.pages[0].html;
        } else {
          document.getElementById("page-title").textContent = `Campaign Finance - ${seat}`;
        }
      })
      .catch(() => {
        document.getElementById("page-title").textContent = `Campaign Finance - ${seat}`;
      });

    document.getElementById("finance-seat-app").dataset.seat = seat;
  })();
</script>
