{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas">
    {{#get "pages" filter="slug:job-{{seat}}" limit="1"}}
            {{#foreach pages}}
                {{{content}}}
            {{/foreach}}
        {{else}}
            {{#get "pages" filter="slug:job" limit="1"}}
      
      
      
      
                {{#foreach pages}}
                    {{{content}}}
                {{/foreach}}




    {{else}}
      <h1>Job: {{seat}}</h1>
      <p>Information about this elected position.</p>
      <p>
        <em>Configure by creating a Page with slug: <code>job</code> or <code>job-{{seat}}</code></em>
      </p>
    {{/get}}
        {{/get}}
  </section>

  <section class="job-data">
    <div class="gh-canvas">
      <div id="job-app" data-seat="{{seat}}">
        <p>Job/seat data loads here</p>
      </div>
    </div>
  </section>
</main>
