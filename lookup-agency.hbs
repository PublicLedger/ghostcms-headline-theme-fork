{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas" id="page-content">
    {{#get "pages" filter="slug:lookup-agency" limit="1"}}
      
      {{#foreach pages}}
        {{{content}}}
      {{/foreach}}

    {{else}}
      <h1 id="page-title">Agency Lookup</h1>
      <p>View officials for this agency.</p>
      <p>
        <em>Configure by creating a Page with slug: <code>lookup-agency</code></em>
      </p>
    {{/get}}
  </section>

  <section class="agency-lookup">
    <div class="gh-canvas">
      <div id="agency-lookup-app">
        <p>Agency-specific lookup loads here</p>
      </div>
    </div>
  </section>
</main>

<script>
  (function () {
    const pathParts = window.location.pathname.split("/").filter(p => p);
    const agency = pathParts[1];
    if (!agency) return;

    const specificSlug = `lookup-agency-${agency}`;
    fetch(`/ghost/api/content/pages/slug/${specificSlug}/?key=${window.ghostContentApiKey || ""}`)
      .then(res => (res.ok ? res.json() : null))
      .then(data => {
        if (data && data.pages && data.pages[0]) {
          document.getElementById("page-content").innerHTML = data.pages[0].html;
        } else {
          document.getElementById("page-title").textContent = `Lookup - ${agency}`;
        }
      })
      .catch(() => {
        document.getElementById("page-title").textContent = `Lookup - ${agency}`;
      });

    document.getElementById("agency-lookup-app").dataset.agency = agency;
  })();
</script>
