{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas">
    {{#get "pages" filter="slug:official-agency-{{agency}}" limit="1"}}
      {{#foreach pages}}
        {{{content}}}
      {{/foreach}}
    {{else}}
      {{#get "pages" filter="slug:official-agency" limit="1"}}
      
        {{#foreach pages}}
          {{{content}}}
        {{/foreach}}

    {{else}}
      <h1>Officials - {{agency}}</h1>
      <p>Elected officials serving in this agency.</p>
      <p>
        <em
          >Configure by creating a Page with slug: <code>official-agency</code> or
          <code>official-agency-{{agency}}</code></em
        >
      </p>
    {{/get}}
    {{/get}}
  </section>

  <section class="agency-officials">
    <div class="gh-canvas">
      <div id="officials-agency-app" data-agency="{{agency}}">
        <p>Officials directory loads here via PublicLedgerData API</p>
      </div>
    </div>
  </section>
</main>
