{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas" id="page-content">
    {{#get "pages" filter="slug:election-agency-seat" limit="1"}}
      {{#foreach pages}}
        {{{content}}}
      {{/foreach}}
    {{else}}
      <h1 id="page-title">Seat Elections</h1>
      <p>Historical election results for this seat.</p>
      <p><em>Configure by creating a Page with slug: <code>election-agency-seat</code></em></p>
    {{/get}}
  </section>

  <section class="seat-elections">
    <div class="gh-canvas">
      <div id="election-seat-app">
        <p>Seat election history loads here</p>
      </div>
    </div>
  </section>
</main>

<script>
  (function() {
    const pathParts = window.location.pathname.split("/").filter(p => p);
    const agency = pathParts[1];
    const seat = pathParts[2];
    if (!agency || !seat) return;
    
    const specificSlug = `election-agency-seat-${agency}-${seat}`;
    fetch(`/ghost/api/content/pages/slug/${specificSlug}/?key=${window.ghostContentApiKey || ''}`)
      .then(res => res.ok ? res.json() : null)
      .then(data => {
        if (data && data.pages && data.pages[0]) {
          document.getElementById('page-content').innerHTML = data.pages[0].html;
        } else {
          document.getElementById('page-title').textContent = `Elections - ${seat} (${agency})`;
        }
      })
      .catch(() => { document.getElementById('page-title').textContent = `Elections - ${seat} (${agency})`; });
    
    const app = document.getElementById('election-seat-app');
    app.dataset.agency = agency;
    app.dataset.seat = seat;
  })();
</script>
