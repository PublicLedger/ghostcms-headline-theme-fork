{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas" id="page-content">
    {{#get "pages" filter="slug:official" limit="1"}}
      
      {{#foreach pages}}
        {{{content}}}
      {{/foreach}}

    {{else}}
      <h1 id="page-title">Official Profile</h1>
      <p>Biography and contact information.</p>
      <p>
        <em>Configure by creating a Page with slug: <code>official</code></em>
      </p>
    {{/get}}
  </section>

  <section class="official-profile">
    <div class="gh-canvas">
      <div id="official-app">
        <p>Official profile loads here (bio, contact, voting record, campaign finance)</p>
      </div>
    </div>
  </section>
</main>

<script>
  (function () {
    const pathParts = window.location.pathname.split("/").filter(p => p);
    const slug = pathParts[1];
    if (!slug) return;

    const specificSlug = `official-${slug}`;
    fetch(`/ghost/api/content/pages/slug/${specificSlug}/?key=${window.ghostContentApiKey || ""}`)
      .then(res => (res.ok ? res.json() : null))
      .then(data => {
        if (data && data.pages && data.pages[0]) {
          document.getElementById("page-content").innerHTML = data.pages[0].html;
        }
      })
      .catch(() => {});

    document.getElementById("official-app").dataset.slug = slug;
  })();
</script>
