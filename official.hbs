{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas">
    {{#get "pages" filter="slug:official-{{slug}}" limit="1"}}
            {{#foreach pages}}
                {{{content}}}
            {{/foreach}}
        {{else}}
            {{#get "pages" filter="slug:official" limit="1"}}
      
      
      
      
                {{#foreach pages}}
                    {{{content}}}
                {{/foreach}}




    {{else}}
      <h1>Official Profile</h1>
      <p>Biography and contact information.</p>
      <p>
        <em>Configure by creating a Page with slug: <code>official</code> or <code>official-{{slug}}</code></em>
      </p>
    {{/get}}
        {{/get}}
  </section>

  <section class="official-profile">
    <div class="gh-canvas">
      <div id="official-app" data-slug="{{slug}}">
        <p>Official profile loads here (bio, contact, voting record, campaign finance)</p>
      </div>
    </div>
  </section>
</main>
