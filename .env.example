# Ghost Development Environment Variables
# Copy to .env and fill in. .env is gitignored; this template is not.
# compose treats .env as optional (required: false), so a fresh clone still builds.

# Ghost Admin Auto-Login Credentials (local dev instance only)
GHOST_ADMIN_EMAIL=admin@example.com
GHOST_ADMIN_PASSWORD=RandomSecure123456789
GHOST_ADMIN_NAME=PublicLedger Admin
GHOST_SITE_TITLE=The Public Ledger

# Ghost URLs — two different things, DO NOT CHANGE either.
#
# GHOST_API_URL is where scripts SEND requests. The devcontainer shares ghost-dev's
# network namespace, so Ghost is on 2368 from inside both containers; 3001 is the
# host publish and is reachable from neither.
#
# GHOST_SITE_URL is the origin Ghost VALIDATES writes against — it must match the
# `url` set on the ghost-dev service, which is the host-facing 3001. Setting this to
# the API URL makes every Admin API write fail with "Request made from incorrect
# origin".
GHOST_API_URL=http://localhost:2368
GHOST_SITE_URL=http://localhost:3001

# Production Ghost credentials (optional — only needed for `pnpm ghost:seed`)
# Ghost Admin → Settings → Integrations → Add custom integration → Content API Key
#
# Use the CONTENT API key. Never put the Admin API key here: this file is injected
# into the devcontainer via env_file and is readable by every process there, and Ghost
# Admin API keys cannot be scoped — one grants full read/write access to members' PII,
# staff accounts, and settings. The seeder only reads published pages.
#
# Consequence: the Content API returns published pages only, so production drafts
# are not seeded.
GHOST_PRD_KEY=<content-api-key>
GHOST_PRD_URL=https://publicledger.ghost.io
GHOST_PRD_PUBLIC_URL=https://publicledger.news
