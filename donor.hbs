{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas">
    {{#get "pages" filter="slug:donor-{{slug}}" limit="1"}}
      {{#foreach pages}}
        {{{content}}}
      {{/foreach}}
    {{else}}
      {{#get "pages" filter="slug:donor" limit="1"}}
      
      
      
      
        {{#foreach pages}}
          {{{content}}}
        {{/foreach}}




    {{else}}
      <h1>Donor Profile</h1>
      <p>Contribution history and relationships.</p>
      <p>
        <em>Configure by creating a Page with slug: <code>donor</code> or <code>donor-{{slug}}</code></em>
      </p>
    {{/get}}
    {{/get}}
  </section>

  <article class="gh-article gh-donor-profile">
    <header class="gh-article-header gh-canvas">
      <h1 class="gh-article-title donor-name" data-donor-id="{{id}}"></h1>
      <div class="donor-meta">
        <span class="donor-type"></span>
        <span class="donor-location"></span>
      </div>
    </header>

    <section class="gh-content gh-canvas">
      <div class="donor-summary">
        <h2>Contribution Summary</h2>
        <div class="finance-cards">
          <div class="finance-card">
            <span class="label">Total Contributions</span>
            <span class="value" data-amount="totalContributions">Loading...</span>
          </div>
          <div class="finance-card">
            <span class="label">Number of Contributions</span>
            <span class="value" data-count="contributionCount">0</span>
          </div>
          <div class="finance-card">
            <span class="label">Recipients Supported</span>
            <span class="value" data-count="recipientCount">0</span>
          </div>
        </div>
      </div>

      <div class="donor-relationships" id="relationshipsSection" style="display: none;">
        <h2>Related Donors</h2>
        <div id="relationshipsList">
          <p>Loading relationship information...</p>
        </div>
      </div>

      <div class="donor-contributions">
        <h2>Contribution History</h2>
        <div id="contributionsList">
          <p>Loading contribution data...</p>
        </div>
      </div>

      <div class="donor-recipients">
        <h2>Top Recipients</h2>
        <div id="recipientsList">
          <p>Loading recipient data...</p>
        </div>
      </div>
    </section>
  </article>
</main>

<script>
  (async function () {
    // Get donor ID from URL path
    const pathParts = window.location.pathname.split("/").filter(p => p);
    const donorId = pathParts[pathParts.length - 1];

    try {
      // Load donor data
      const donor = await window.PublicLedgerData.getDonor(donorId);

      if (!donor) {
        document.querySelector(".donor-name").textContent = "Donor Not Found";
        return;
      }

      // Display donor name
      document.querySelector(".donor-name").textContent = donor.name;

      // Display donor type and location
      const donorType = donor.type ? `${donor.type}${donor.subtype ? " - " + donor.subtype : ""}` : "Individual";
      document.querySelector(".donor-type").textContent = donorType;

      if (donor.address) {
        document.querySelector(".donor-location").textContent = `${donor.address.city}, ${donor.address.state}`;
      }

      // Display contribution summary
      document.querySelector('[data-amount="totalContributions"]').textContent = window.PublicLedgerData.formatCurrency(
        donor.totalContributions || 0
      );
      document.querySelector('[data-count="contributionCount"]').textContent = donor.contributionCount || 0;
      document.querySelector('[data-count="recipientCount"]').textContent = donor.recipientCount || 0;

      // Load and display relationships
      const relationships = await window.PublicLedgerData.getDonorRelationships(donorId);

      if (relationships && relationships.length > 0) {
        const relationshipsSection = document.getElementById("relationshipsSection");
        relationshipsSection.style.display = "block";

        const relationshipsList = document.getElementById("relationshipsList");
        let relationshipsHtml = "";

        for (const rel of relationships) {
          // Get other members of the relationship
          const otherMembers = rel.members.filter(id => id !== donorId);

          relationshipsHtml += `
            <div class="relationship-card">
              <div class="relationship-type">${rel.description}</div>
              ${rel.notes ? `<p class="relationship-notes">${rel.notes}</p>` : ""}
              <div class="relationship-members">
                <h3>Related Donors:</h3>
                <ul>
          `;

          // Fetch details for each related donor
          for (const memberId of otherMembers) {
            try {
              const relatedDonor = await window.PublicLedgerData.getDonor(memberId);
              if (relatedDonor) {
                relationshipsHtml += `
                  <li>
                    <a href="/donors/${memberId}/">${relatedDonor.name}</a>
                    <span class="donor-contrib-info">
                      ${window.PublicLedgerData.formatCurrency(relatedDonor.totalContributions || 0)}
                      in ${relatedDonor.contributionCount || 0} contributions
                    </span>
                  </li>
                `;
              }
            } catch (error) {
              console.error(`Failed to load related donor ${memberId}:`, error);
            }
          }

          relationshipsHtml += `
                </ul>
              </div>
            </div>
          `;
        }

        relationshipsList.innerHTML = relationshipsHtml;
      } else {
        document.getElementById("relationshipsSection").style.display = "none";
      }

      // Placeholder for contribution history
      document.getElementById("contributionsList").innerHTML =
        "<p>Detailed contribution data will be loaded from campaign finance records.</p>";

      // Placeholder for recipients
      document.getElementById("recipientsList").innerHTML = `<p>Top recipient: ${donor.topRecipient || "N/A"}</p>`;
    } catch (error) {
      console.error("Error loading donor:", error);
      document.querySelector(".donor-name").textContent = "Error Loading Donor";
    }
  })();
</script>

<style>
  .donor-meta {
    color: var(--color-secondary-text);
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  .donor-meta span:not(:last-child)::after {
    content: " • ";
    margin: 0 0.5rem;
  }

  .donor-summary {
    margin: 3rem 0;
  }

  .finance-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .finance-card {
    background: var(--color-lighter-gray);
    padding: 1.5rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .finance-card .label {
    font-size: 0.875rem;
    color: var(--color-secondary-text);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .finance-card .value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-darkgrey);
  }

  .donor-relationships,
  .donor-contributions,
  .donor-recipients {
    margin: 3rem 0;
  }

  .relationship-card {
    background: var(--color-lighter-gray);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  .relationship-type {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .relationship-notes {
    color: var(--color-secondary-text);
    font-style: italic;
    margin-bottom: 1rem;
  }

  .relationship-members ul {
    list-style: none;
    padding: 0;
    margin-top: 0.5rem;
  }

  .relationship-members li {
    padding: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .relationship-members li:last-child {
    border-bottom: none;
  }

  .relationship-members a {
    font-weight: 600;
    color: var(--color-darkgrey);
    text-decoration: none;
  }

  .relationship-members a:hover {
    color: var(--color-primary);
  }

  .donor-contrib-info {
    display: block;
    font-size: 0.875rem;
    color: var(--color-secondary-text);
    margin-top: 0.25rem;
  }
</style>
