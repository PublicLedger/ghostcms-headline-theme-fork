{{!< default}} {{!-- Candidate Profile Template --}}

<article class="gh-article gh-candidate-profile">
  <header class="gh-article-header gh-canvas">
    <h1 class="gh-article-title candidate-name" data-candidate-slug="{{slug}}"></h1>
    <div class="candidate-meta">
      <span class="candidate-party"></span>
      <span class="candidate-office"></span>
    </div>
  </header>

  <section class="gh-content gh-canvas">
    <div class="candidate-summary">
      <h2>Campaign Finance Summary</h2>
      <div class="finance-cards">
        <div class="finance-card">
          <span class="label">Total Raised</span>
          <span class="value" data-amount="totalRaised">Loading...</span>
        </div>
        <div class="finance-card">
          <span class="label">Total Spent</span>
          <span class="value" data-amount="totalSpent">Loading...</span>
        </div>
        <div class="finance-card">
          <span class="label">Cash on Hand</span>
          <span class="value" data-amount="cashOnHand">Loading...</span>
        </div>
      </div>
    </div>

    <div class="candidate-races">
      <h2>Election History</h2>
      <div class="races-list" id="racesList">
        <p>Loading race information...</p>
      </div>
    </div>

    <div class="candidate-finance">
      <h2>Campaign Finance Details</h2>
      <div id="campaignDetails">
        <p>Loading finance data...</p>
      </div>
    </div>

    <div class="candidate-contributions">
      <h3>Top Contributions</h3>
      <div id="contributionsList">
        <p>Loading contributions...</p>
      </div>
    </div>

    <div class="candidate-expenditures">
      <h3>Top Expenditures</h3>
      <div id="expendituresList">
        <p>Loading expenditures...</p>
      </div>
    </div>
  </section>
</article>

<script>
  (async function () {
    const slug = "{{slug}}";
    const { getCandidateBySlug, getCampaign, formatCurrency, formatDate } = window.PublicLedgerData;

    try {
      // Load candidate data
      const candidate = await getCandidateBySlug(slug);

      if (!candidate) {
        document.querySelector(".candidate-name").textContent = "Candidate Not Found";
        return;
      }

      // Update header
      document.querySelector(".candidate-name").textContent = candidate.name.full;
      document.querySelector(".candidate-party").textContent = candidate.party;

      // Update finance summary
      document.querySelector('[data-amount="totalRaised"]').textContent = formatCurrency(candidate.totalRaised);
      document.querySelector('[data-amount="totalSpent"]').textContent = formatCurrency(candidate.totalSpent);
      document.querySelector('[data-amount="cashOnHand"]').textContent = formatCurrency(candidate.cashOnHand);

      // Update races list
      const racesList = document.getElementById("racesList");
      if (candidate.races && candidate.races.length > 0) {
        racesList.innerHTML = candidate.races
          .map(
            raceId => `
                <div class="race-item">
                    <span class="race-id">${raceId}</span>
                </div>
            `
          )
          .join("");
      } else {
        racesList.innerHTML = "<p>No race information available.</p>";
      }

      // Load campaign finance details
      if (candidate.campaigns && candidate.campaigns.length > 0) {
        const campaignId = candidate.campaigns[0]; // Get first campaign
        const campaign = await getCampaign(campaignId);

        if (campaign) {
          // Display campaign summary
          const details = document.getElementById("campaignDetails");
          details.innerHTML = `
                    <div class="campaign-summary">
                        <p><strong>Election:</strong> ${campaign.campaign.election}</p>
                        <p><strong>Committee:</strong> ${campaign.campaign.committee}</p>
                        <p><strong>Contributors:</strong> ${campaign.summary.contributorCount}</p>
                        <p><strong>Avg Contribution:</strong> ${formatCurrency(campaign.summary.avgContribution)}</p>
                    </div>
                `;

          // Display top contributions
          const contribList = document.getElementById("contributionsList");
          if (campaign.contributions && campaign.contributions.length > 0) {
            const topContribs = campaign.contributions.sort((a, b) => b.amount - a.amount).slice(0, 10);

            contribList.innerHTML = `
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Donor</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${topContribs
                                  .map(
                                    c => `
                                    <tr>
                                        <td>${formatDate(c.date)}</td>
                                        <td>${c.donor.name}</td>
                                        <td>${formatCurrency(c.amount)}</td>
                                    </tr>
                                `
                                  )
                                  .join("")}
                            </tbody>
                        </table>
                    `;
          } else {
            contribList.innerHTML = "<p>No contribution data available.</p>";
          }

          // Display top expenditures
          const expList = document.getElementById("expendituresList");
          if (campaign.expenditures && campaign.expenditures.length > 0) {
            const topExps = campaign.expenditures.sort((a, b) => b.amount - a.amount).slice(0, 10);

            expList.innerHTML = `
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Paid To</th>
                                    <th>Category</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${topExps
                                  .map(
                                    e => `
                                    <tr>
                                        <td>${formatDate(e.date)}</td>
                                        <td>${e.paidTo}</td>
                                        <td>${e.subcategory || e.category}</td>
                                        <td>${formatCurrency(e.amount)}</td>
                                    </tr>
                                `
                                  )
                                  .join("")}
                            </tbody>
                        </table>
                    `;
          } else {
            expList.innerHTML = "<p>No expenditure data available.</p>";
          }
        }
      }
    } catch (error) {
      console.error("Error loading candidate data:", error);
      document.querySelector(".gh-content").innerHTML = '<p class="error">Failed to load candidate data.</p>';
    }
  })();
</script>

<style>
  .candidate-meta {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 1.1rem;
    color: var(--color-secondary-text);
  }

  .candidate-summary {
    margin: 2rem 0;
  }

  .finance-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .finance-card {
    padding: 1.5rem;
    background: var(--color-lighter-gray);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
  }

  .finance-card .label {
    font-size: 0.9rem;
    color: var(--color-secondary-text);
    margin-bottom: 0.5rem;
  }

  .finance-card .value {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-darker-gray);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
  }

  .data-table th,
  .data-table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  .data-table th {
    font-weight: 700;
    background: var(--color-lighter-gray);
  }

  .race-item {
    padding: 0.75rem;
    background: var(--color-lighter-gray);
    margin-bottom: 0.5rem;
    border-radius: 4px;
  }

  .error {
    color: #d00;
    padding: 1rem;
    background: #fee;
    border-radius: 4px;
  }
</style>
