{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas">
    {{#get "pages" filter="slug:lookup" limit="1"}}
      
      
      
      
      
            {{#foreach pages}}
                {{{content}}}
            {{/foreach}}





    {{else}}
      <h1>Voter Lookup</h1>
      <p>Find your elected officials by address.</p>
      <p>
        <em>Configure by creating a Page with slug: <code>lookup</code></em>
      </p>
    {{/get}}
  </section>

  <section class="lookup-tool">
    <div class="gh-canvas">
      <div id="lookup-app">
        <p>Lookup tool loads here via PublicLedgerData API</p>
      </div>
    </div>
  </section>
</main>
