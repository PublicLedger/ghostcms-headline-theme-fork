<!--
  Election Result Fragment Template
  
  Ghost Page slug: election-result
  Usage in templates: {{#get "pages" slug="election-result"}}{{content}}{{/get}}
  
  This Handlebars template displays Election Result data.
  Variables are replaced by scripts/update-election-result-cards.js.
-->

<div class="election-result-card custom-card" data-card-type="election-result">
  <div class="custom-card-header">
    <h3 class="custom-card-title">{{title}}</h3>
    <a href="{{url}}" class="custom-card-link" target="_blank" rel="noopener"> View details ↗ </a>
  </div>

  <div class="custom-card-timeline">
    {{#each events}}
      <div class="custom-card-timeline-item">
        <div class="timeline-date">{{date}}</div>
        <div class="timeline-title">{{title}}</div>
        <div class="timeline-description">{{description}}</div>
      </div>
    {{/each}}
  </div>
  <div class="custom-card-footer">Source: {{source}} · Last updated {{updated-date}}</div>
</div>
