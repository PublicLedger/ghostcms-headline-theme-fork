<!--
  CensusReporter Fragment Template
  
  Ghost Page slug: census-reporter-{{agency}}
  Usage in templates: {{#get "pages" slug="census-reporter"}}{{content}}{{/get}}
  
  Template with {{placeholder}} variables for quarterly data updates.
  Current working example: lancaster-county-profile (hardcoded data).
-->

<div class="census-reporter-card custom-card" data-agency="{{agency}}">
  <div class="census-reporter-header">
    <h3 class="census-reporter-title">{{agency-display}} — Census Profile</h3>
    <a href="{{census-url}}" class="census-reporter-link" target="_blank" rel="noopener">
      Full data via Census Reporter ↗
    </a>
  </div>

  <div class="census-reporter-grid">
    <!-- Residents 18+ -->
    <div class="census-metric">
      <div class="census-metric-label">Residents 18+</div>
      <div class="census-metric-value">{{residents-18-plus}}</div>
      <div class="census-metric-sublabel">eligible voters</div>
    </div>

    <!-- Race & Ethnicity -->
    <div class="census-metric">
      <div class="census-metric-label">Race &amp; Ethnicity</div>
      <div class="census-stats">
        <div class="census-stat-row">
          <div class="census-stat-label">White (non-Hispanic)</div>
          <div class="census-stat-bar" data-category="white" style="width: {{race-white-pct}}%"></div>
          <span class="census-stat-value">{{race-white-pct}}%</span>
        </div>
        <div class="census-stat-row">
          <div class="census-stat-label">Hispanic / Latino</div>
          <div class="census-stat-bar" data-category="hispanic" style="width: {{race-hispanic-pct}}%"></div>
          <span class="census-stat-value">{{race-hispanic-pct}}%</span>
        </div>
        <div class="census-stat-row">
          <div class="census-stat-label">Two or more races</div>
          <div class="census-stat-bar" data-category="two-or-more" style="width: {{race-mixed-pct}}%"></div>
          <span class="census-stat-value">{{race-mixed-pct}}%</span>
        </div>
        <div class="census-stat-row">
          <div class="census-stat-label">Other</div>
          <div class="census-stat-bar" data-category="other" style="width: {{race-other-pct}}%"></div>
          <span class="census-stat-value">{{race-other-pct}}%</span>
        </div>
      </div>
    </div>

    <!-- Median Income -->
    <div class="census-metric">
      <div class="census-metric-label">Median Household Income</div>
      <div class="census-metric-value">${{median-income}}</div>
      <div class="census-metric-sublabel">per household / year</div>
    </div>

    <!-- Education -->
    <div class="census-metric">
      <div class="census-metric-label">Education (25+)</div>
      <div class="census-stats">
        <div class="census-stat-row">
          <div class="census-stat-label">Less than high school</div>
          <div class="census-stat-bar" data-category="less-than-hs" style="width: {{edu-less-hs-pct}}%"></div>
          <span class="census-stat-value">{{edu-less-hs-pct}}%</span>
        </div>
        <div class="census-stat-row">
          <div class="census-stat-label">High school / GED</div>
          <div class="census-stat-bar" data-category="hs-ged" style="width: {{edu-hs-pct}}%"></div>
          <span class="census-stat-value">{{edu-hs-pct}}%</span>
        </div>
        <div class="census-stat-row">
          <div class="census-stat-label">Some college / Assoc.</div>
          <div class="census-stat-bar" data-category="some-college" style="width: {{edu-some-college-pct}}%"></div>
          <span class="census-stat-value">{{edu-some-college-pct}}%</span>
        </div>
        <div class="census-stat-row">
          <div class="census-stat-label">Bachelor's degree</div>
          <div class="census-stat-bar" data-category="bachelors" style="width: {{edu-bachelors-pct}}%"></div>
          <span class="census-stat-value">{{edu-bachelors-pct}}%</span>
        </div>
        <div class="census-stat-row">
          <div class="census-stat-label">Graduate / Professional</div>
          <div class="census-stat-bar" data-category="graduate" style="width: {{edu-graduate-pct}}%"></div>
          <span class="census-stat-value">{{edu-graduate-pct}}%</span>
        </div>
      </div>
    </div>
  </div>

  <div class="census-reporter-footer">
    Source: U.S. Census Bureau, ACS 2024 1-year · Population estimates for the jurisdiction this official serves
  </div>
</div>
