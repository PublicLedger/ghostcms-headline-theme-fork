<!--
  Voter Turnout Fragment - Demo
  Ghost Page slug: voter-turnout-demo
  
  Lancaster County voter turnout example from 2025 Municipal General Election.
-->

<div class="voter-turnout-card custom-card" data-card-type="voter-turnout">
  <div class="custom-card-badge-wrapper">
    <span class="custom-card-badge custom-card-badge--muted">HOW VOTERS PICK WHO GETS THE JOB</span>
  </div>

  <h2 class="voter-turnout-title">See how much your vote counts</h2>

  <p class="voter-turnout-intro">
    Out of 500,000 voting-age residents in Lancaster County, only 153,706 (30.7%) actually voted in the last election.
  </p>

  <h3 class="voter-turnout-subtitle">2025 MUNICIPAL GENERAL ELECTION — LANCASTER COUNTY</h3>

  <div class="voter-turnout-stats">
    <div class="voter-turnout-stat">
      <div class="voter-turnout-stat-header">
        <span class="voter-turnout-stat-label">Voting-age residents (18+)</span>
        <span class="voter-turnout-stat-value">500,000 <span class="voter-turnout-stat-pct">(100%)</span></span>
      </div>
      <div class="voter-turnout-stat-bar" style="width: 100%; background: #94a3b8;"></div>
    </div>

    <div class="voter-turnout-stat">
      <div class="voter-turnout-stat-header">
        <span class="voter-turnout-stat-label">Registered to vote</span>
        <span class="voter-turnout-stat-value">360,083 <span class="voter-turnout-stat-pct">(72%)</span></span>
      </div>
      <div class="voter-turnout-stat-bar" style="width: 72%; background: #94a3b8;"></div>
    </div>

    <div class="voter-turnout-stat">
      <div class="voter-turnout-stat-header">
        <span class="voter-turnout-stat-label">Voted in general election</span>
        <span class="voter-turnout-stat-value">153,706 <span class="voter-turnout-stat-pct">(30.7%)</span></span>
      </div>
      <div class="voter-turnout-stat-bar" style="width: 30.7%; background: #3b82f6;"></div>
    </div>

    <div class="voter-turnout-stat">
      <div class="voter-turnout-stat-header">
        <span class="voter-turnout-stat-label">Voted for county controller</span>
        <span class="voter-turnout-stat-value">106,400 <span class="voter-turnout-stat-pct">(21.3%)</span></span>
      </div>
      <div class="voter-turnout-stat-bar" style="width: 21.3%; background: #3b82f6;"></div>
    </div>
  </div>

  <p class="voter-turnout-note">43% turnout among registered voters; just 30% voted in the county controller race.</p>

  <a href="/elections/turnout/" class="voter-turnout-cta">Explore how voters turn out →</a>
</div>
