<!--
  Election Result Fragment - Demo
  Ghost Page slug: election-result-demo
  
  Lancaster County 2023 election result example.
-->

<div class="election-result-card custom-card" data-card-type="election-result">
  <div class="election-result-header">
    <div class="election-result-year">2023</div>
    <div class="election-result-date">November 7, 2023</div>
    <span class="custom-card-badge">GENERAL</span>
    <span class="custom-card-badge custom-card-badge--success">Won</span>
  </div>

  <div class="election-result-turnout">
    <strong>145,555</strong> voters cast a ballot
    <span class="election-result-muted">out of</span>
    <strong>283,733</strong> registered — only <strong>51.3%</strong> turnout
  </div>

  <div class="election-result-winner">
    <div class="election-result-winner-votes">105,234</div>
    <div class="election-result-winner-text">people chose <strong>Dennis Moyer</strong> — 72.3% of votes cast</div>
  </div>

  <div class="election-result-bars">
    <div class="election-result-bar-container">
      <div class="election-result-bar election-result-bar--winner" style="width: 72.3%;"></div>
      <div class="election-result-bar election-result-bar--loser" style="width: 27.7%;"></div>
    </div>
    <div class="election-result-legend">
      <span class="election-result-legend-item">
        <span class="election-result-legend-dot election-result-legend-dot--winner"></span>
        Dennis Moyer
      </span>
      <span class="election-result-legend-item">
        <span class="election-result-legend-dot election-result-legend-dot--loser"></span>
        James Porter
      </span>
    </div>
  </div>
</div>
