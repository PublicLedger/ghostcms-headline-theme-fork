{{!< default}}

<main class="gh-main">
  {{!-- OPTIONAL: Custom Page content (if exists) --}}
  {{#if page}}
    <section class="gh-content gh-canvas">
      <article class="gh-article">
        {{{page.html}}}
      </article>
    </section>
  {{/if}}

  {{!-- ALWAYS: Data-driven section --}}
  <section class="job-data">
    <div class="gh-canvas">
      <div id="job-seat-app">
        <h2>Position Data</h2>
        <p>Current officeholder, salary, responsibilities, and election history would load here from PublicLedgerData API.</p>
      </div>
    </div>
  </section>
</main>
