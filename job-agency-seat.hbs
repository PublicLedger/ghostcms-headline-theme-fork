{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas">
    {{#get "pages" filter="slug:job-agency-seat-{{agency}}-{{seat}}" limit="1"}}
            {{#foreach pages}}
                {{{content}}}
            {{/foreach}}
        {{else}}
            {{#get "pages" filter="slug:job-agency-seat" limit="1"}}
      
      
      
      
                {{#foreach pages}}
                    {{{content}}}
                {{/foreach}}




    {{else}}
      <h1>{{seat}} - {{agency}}</h1>
      <p>Information about this elected position.</p>
      <p>
        <em
          >Configure by creating a Page with slug: <code>job-agency-seat</code> or
          <code>job-agency-seat-{{agency}}-{{seat}}</code></em
        >
      </p>
    {{/get}}
        {{/get}}
  </section>

  <section class="job-data">
