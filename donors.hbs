{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas">
    {{#get "pages" filter="slug:donors" limit="1"}}
      
      
      
      
      
            {{#foreach pages}}
                {{{content}}}
            {{/foreach}}





    {{else}}
      <h1>Donor Directory</h1>
      <p>Search campaign donors and contribution history.</p>
      <p>
        <em>Configure by creating a Page with slug: <code>donors</code></em>
      </p>
    {{/get}}
  </section>

  <section class="donors-directory">
    <div class="gh-canvas">
      <div id="donors-app">
        <p>Donor search and directory loads here via PublicLedgerData API</p>
      </div>
    </div>
  </section>
</main>
