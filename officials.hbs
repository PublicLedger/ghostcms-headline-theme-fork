{{!< default}}

<main class="gh-main">
  <section class="gh-content gh-canvas">
    {{#get "pages" filter="slug:officials" limit="1"}}
      
      
      
      
      
            {{#foreach pages}}
                {{{content}}}
            {{/foreach}}





    {{else}}
      <h1>Elected Officials Directory</h1>
      <p>Browse all currently serving elected officials.</p>
      <p>
        <em>Configure by creating a Page with slug: <code>officials</code></em>
      </p>
    {{/get}}
  </section>

  <section class="officials-directory">
    <div class="gh-canvas">
      <div id="officials-app">
        <p>Officials directory loads here via PublicLedgerData API</p>
      </div>
    </div>
  </section>
</main>
